{
  "info": {
    "name": "Employee Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Asha Verma\",\n  \"email\": \"asha.verma@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"date_of_joining\": \"2024-06-17\",\n  \"salary\": 850000,\n  \"status\": \"Active\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('employeeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List employees (page 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?page=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Search + filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?search=asha&department=Engineering&status=Active&page=1&page_size=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "search",
              "value": "asha"
            },
            {
              "key": "department",
              "value": "Engineering"
            },
            {
              "key": "status",
              "value": "Active"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "page_size",
              "value": "10"
            }
          ]
        }
      }
    },
    {
      "name": "Get employee",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"full_name\": \"Asha Verma\",\n  \"email\": \"asha.verma@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Senior Engineer\",\n  \"date_of_joining\": \"2024-06-17\",\n  \"salary\": 850000,\n  \"status\": \"Active\"\n}"
        }
      }
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        }
      }
    },
    {
      "name": "Export CSV",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/export/csv?department=Engineering",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "export",
            "csv"
          ],
          "query": [
            {
              "key": "department",
              "value": "Engineering"
            }
          ]
        }
      }
    },
    {
      "name": "List departments",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/departments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "departments"
          ]
        }
      }
    }
  ]
}